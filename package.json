{
  "name": "reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "npm run build && node src/server/main.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "fixtures": "node scripts/make-fixtures.ts",
    "fonts:build": "python scripts/build-fonts.py"
  },
  "dependencies": {
    "@fontsource/libertinus-serif": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "^5.11.2",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "markdown-it": "^15.0.2",
    "preact": "^11.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.1",
    "@types/yauzl": "^3.4.0",
    "fflate": "^0.8.3",
    "iconv-lite": "^0.7.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
